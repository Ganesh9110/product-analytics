USE product_analytics;

SELECT
    (SELECT COUNT(*) FROM app_events) AS total_events,
    (SELECT COUNT(*) FROM orders) AS total_orders,
    (SELECT COUNT(DISTINCT user_id) FROM app_events) AS event_users,
    (SELECT COUNT(DISTINCT user_id) FROM orders) AS order_customers;
    
    
--- How much revenue does the business generate? ---

SELECT
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    SUM(quantity) AS total_units_sold,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
WHERE order_status = 'Delivered';

--- Which months generate the highest revenue? --

SELECT
    YEAR(order_date) AS order_year,
    MONTH(order_date) AS order_month,
    DATE_FORMAT(order_date, '%Y-%m') AS month,
    COUNT(*) AS total_orders,
    ROUND(SUM(net_amount_inr), 2) AS monthly_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
WHERE order_status = 'Delivered'
GROUP BY
    YEAR(order_date),
    MONTH(order_date),
    DATE_FORMAT(order_date, '%Y-%m')
ORDER BY order_year, order_month;


--- Is revenue growing or declining month over month? ---


WITH monthly_revenue AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        SUM(net_amount_inr) AS revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
),
revenue_growth AS (
    SELECT
        month,
        revenue,
        LAG(revenue) OVER (ORDER BY month) AS previous_month_revenue
    FROM monthly_revenue
)
SELECT
    month,
    ROUND(revenue, 2) AS current_revenue,
    ROUND(previous_month_revenue, 2) AS previous_month_revenue,
    ROUND(
        (revenue - previous_month_revenue)
        / NULLIF(previous_month_revenue, 0) * 100,
        2
    ) AS mom_growth_pct
FROM revenue_growth
ORDER BY month;

--- Which products generate the most revenue? ---

SELECT
    product_id,
    product_name,
    category,
    COUNT(*) AS total_orders,
    SUM(quantity) AS units_sold,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
WHERE order_status = 'Delivered'
GROUP BY
    product_id,
    product_name,
    category
ORDER BY total_revenue DESC;

--- Which product categories generate the most revenue? --

SELECT
    category,
    COUNT(*) AS total_orders,
    SUM(quantity) AS total_units_sold,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        SUM(net_amount_inr) * 100 /
        SUM(SUM(net_amount_inr)) OVER (),
        2
    ) AS revenue_contribution_pct
FROM orders
WHERE order_status = 'Delivered'
GROUP BY category
ORDER BY total_revenue DESC;

-- Who are the repeat customers? ---

WITH customer_orders AS (
    SELECT
        user_id,
        COUNT(*) AS total_orders,
        SUM(net_amount_inr) AS total_spent,
        AVG(net_amount_inr) AS average_order_value
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
)
SELECT
    CASE
        WHEN total_orders = 1 THEN 'One-time Customer'
        ELSE 'Repeat Customer'
    END AS customer_type,
    COUNT(*) AS total_customers,
    SUM(total_orders) AS total_orders,
    ROUND(SUM(total_spent), 2) AS total_revenue,
    ROUND(AVG(average_order_value), 2) AS average_customer_order_value
FROM customer_orders
GROUP BY customer_type
ORDER BY total_customers DESC;


-- Which cities generate the most revenue? ---

SELECT
    city,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    SUM(quantity) AS units_sold,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
WHERE order_status = 'Delivered'
  AND city IS NOT NULL
GROUP BY city
ORDER BY total_revenue DESC;

-- Which payment methods do customers prefer? ---

SELECT
    payment_method,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),
        2
    ) AS order_share_pct
FROM orders
WHERE order_status = 'Delivered'
GROUP BY payment_method
ORDER BY total_revenue DESC;

-- How many orders are successfully delivered, cancelled or returned?---

SELECT
    order_status,
    COUNT(*) AS total_orders,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),
        2
    ) AS order_percentage,
    ROUND(SUM(net_amount_inr), 2) AS total_order_value,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
GROUP BY order_status
ORDER BY total_orders DESC;

-- Which acquisition channels bring customers and revenue? ---

SELECT
    acquisition_channel,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),
        2
    ) AS order_share_pct
FROM orders
WHERE order_status = 'Delivered'
GROUP BY acquisition_channel
ORDER BY total_revenue DESC;

-- What is the yearly revenue trend? --

WITH yearly_revenue AS (
    SELECT
        YEAR(order_date) AS order_year,
        COUNT(*) AS total_orders,
        COUNT(DISTINCT user_id) AS unique_customers,
        SUM(net_amount_inr) AS revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY YEAR(order_date)
),
yearly_growth AS (
    SELECT
        order_year,
        total_orders,
        unique_customers,
        revenue,
        LAG(revenue) OVER (ORDER BY order_year) AS previous_year_revenue
    FROM yearly_revenue
)
SELECT
    order_year,
    total_orders,
    unique_customers,
    ROUND(revenue, 2) AS yearly_revenue,
    ROUND(previous_year_revenue, 2) AS previous_year_revenue,
    ROUND(
        (revenue - previous_year_revenue)
        / NULLIF(previous_year_revenue, 0) * 100,
        2
    ) AS yoy_growth_pct
FROM yearly_growth
ORDER BY order_year;


-- Customer ranking---

WITH customer_revenue AS (
    SELECT
        user_id,
        COUNT(*) AS total_orders,
        SUM(net_amount_inr) AS total_revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
customer_ranking AS (
    SELECT
        user_id,
        total_orders,
        total_revenue,
        RANK() OVER (
            ORDER BY total_revenue DESC
        ) AS revenue_rank
    FROM customer_revenue
)
SELECT
    user_id,
    total_orders,
    ROUND(total_revenue, 2) AS total_revenue,
    revenue_rank
FROM customer_ranking
WHERE revenue_rank <= 10
ORDER BY revenue_rank;

-- Which customers are at risk of becoming inactive?--

WITH customer_activity AS (
    SELECT
        user_id,
        COUNT(*) AS total_orders,
        SUM(net_amount_inr) AS total_revenue,
        MAX(order_date) AS last_order_date
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
)
SELECT
    user_id,
    total_orders,
    ROUND(total_revenue, 2) AS total_revenue,
    last_order_date,
    DATEDIFF(
        (SELECT MAX(order_date) FROM orders),
        last_order_date
    ) AS days_since_last_order,
    CASE
        WHEN DATEDIFF(
            (SELECT MAX(order_date) FROM orders),
            last_order_date
        ) <= 30 THEN 'Active'
        WHEN DATEDIFF(
            (SELECT MAX(order_date) FROM orders),
            last_order_date
        ) <= 90 THEN 'At Risk'
        ELSE 'Inactive'
    END AS customer_segment
FROM customer_activity
ORDER BY days_since_last_order DESC;

-- How many customers are Active, At Risk and Inactive? --

WITH customer_activity AS (
    SELECT
        user_id,
        COUNT(*) AS total_orders,
        SUM(net_amount_inr) AS total_revenue,
        MAX(order_date) AS last_order_date
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
customer_segments AS (
    SELECT
        user_id,
        total_orders,
        total_revenue,
        CASE
            WHEN DATEDIFF(
                (SELECT MAX(order_date) FROM orders),
                last_order_date
            ) <= 30 THEN 'Active'
            WHEN DATEDIFF(
                (SELECT MAX(order_date) FROM orders),
                last_order_date
            ) <= 90 THEN 'At Risk'
            ELSE 'Inactive'
        END AS customer_segment
    FROM customer_activity
)
SELECT
    customer_segment,
    COUNT(*) AS total_customers,
    ROUND(SUM(total_revenue), 2) AS total_revenue,
    ROUND(AVG(total_revenue), 2) AS average_customer_revenue
FROM customer_segments
GROUP BY customer_segment
ORDER BY total_customers DESC;

--- RFM customer segmentation --

WITH customer_rfm AS (
    SELECT
        user_id,
        DATEDIFF(
            (SELECT MAX(order_date) FROM orders),
            MAX(order_date)
        ) AS recency,
        COUNT(*) AS frequency,
        SUM(net_amount_inr) AS monetary
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
rfm_scores AS (
    SELECT
        user_id,
        recency,
        frequency,
        monetary,
        NTILE(5) OVER (ORDER BY recency DESC) AS recency_score,
        NTILE(5) OVER (ORDER BY frequency ASC) AS frequency_score,
        NTILE(5) OVER (ORDER BY monetary ASC) AS monetary_score
    FROM customer_rfm
)
SELECT
    user_id,
    recency,
    frequency,
    ROUND(monetary, 2) AS monetary,
    recency_score,
    frequency_score,
    monetary_score
FROM rfm_scores
ORDER BY monetary DESC
LIMIT 20;

-- RFM customer segments --

WITH customer_rfm AS (
    SELECT
        user_id,
        DATEDIFF(
            (SELECT MAX(order_date) FROM orders),
            MAX(order_date)
        ) AS recency,
        COUNT(*) AS frequency,
        SUM(net_amount_inr) AS monetary
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
rfm_scores AS (
    SELECT
        user_id,
        recency,
        frequency,
        monetary,
        NTILE(5) OVER (ORDER BY recency DESC) AS r_score,
        NTILE(5) OVER (ORDER BY frequency ASC) AS f_score,
        NTILE(5) OVER (ORDER BY monetary ASC) AS m_score
    FROM customer_rfm
),
rfm_segments AS (
    SELECT
        *,
        CASE
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4
                THEN 'Champions'
            WHEN f_score >= 4 AND m_score >= 4
                THEN 'Loyal Customers'
            WHEN r_score >= 4 AND f_score <= 2
                THEN 'Recent Customers'
            WHEN r_score <= 2 AND f_score >= 3 AND m_score >= 3
                THEN 'At Risk High Value'
            WHEN r_score <= 2
                THEN 'Inactive Customers'
            ELSE 'Potential Customers'
        END AS customer_segment
    FROM rfm_scores
)
SELECT
    customer_segment,
    COUNT(*) AS total_customers,
    ROUND(SUM(monetary), 2) AS total_revenue,
    ROUND(AVG(monetary), 2) AS average_customer_spend
FROM rfm_segments
GROUP BY customer_segment
ORDER BY total_revenue DESC;

-- Which product is the top performer within each category? --

WITH product_performance AS (
    SELECT
        category,
        product_name,
        COUNT(*) AS total_orders,
        SUM(quantity) AS units_sold,
        SUM(net_amount_inr) AS total_revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY category, product_name
),
product_ranking AS (
    SELECT
        category,
        product_name,
        total_orders,
        units_sold,
        total_revenue,
        RANK() OVER (
            PARTITION BY category
            ORDER BY total_revenue DESC
        ) AS product_rank
    FROM product_performance
)
SELECT
    category,
    product_name,
    total_orders,
    units_sold,
    ROUND(total_revenue, 2) AS total_revenue,
    product_rank
FROM product_ranking
WHERE product_rank = 1
ORDER BY total_revenue DESC;

-- Calculate cumulative monthly revenue --

WITH monthly_revenue AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        SUM(net_amount_inr) AS monthly_revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
)
SELECT
    month,
    ROUND(monthly_revenue, 2) AS monthly_revenue,
    ROUND(
        SUM(monthly_revenue) OVER (
            ORDER BY month
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ),
        2
    ) AS cumulative_revenue
FROM monthly_revenue
ORDER BY month;


-- Which months contribute most to total revenue? --

WITH monthly_revenue AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        SUM(net_amount_inr) AS monthly_revenue
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
)
SELECT
    month,
    ROUND(monthly_revenue, 2) AS monthly_revenue,
    ROUND(
        monthly_revenue * 100 /
        SUM(monthly_revenue) OVER (),
        2
    ) AS revenue_contribution_pct,
    RANK() OVER (
        ORDER BY monthly_revenue DESC
    ) AS revenue_rank
FROM monthly_revenue
ORDER BY revenue_rank;

-- How long does a customer take to make their next purchase? --

WITH customer_purchase_dates AS (
    SELECT
        user_id,
        order_id,
        order_date,
        LAG(order_date) OVER (
            PARTITION BY user_id
            ORDER BY order_date
        ) AS previous_order_date
    FROM orders
    WHERE order_status = 'Delivered'
),
purchase_intervals AS (
    SELECT
        user_id,
        order_id,
        order_date,
        previous_order_date,
        DATEDIFF(order_date, previous_order_date) AS days_between_orders
    FROM customer_purchase_dates
    WHERE previous_order_date IS NOT NULL
)
SELECT
    user_id,
    order_id,
    order_date,
    previous_order_date,
    days_between_orders
FROM purchase_intervals
ORDER BY days_between_orders DESC
LIMIT 20;

-- What is the average purchase interval? --

WITH customer_purchase_dates AS (
    SELECT
        user_id,
        order_date,
        LAG(order_date) OVER (
            PARTITION BY user_id
            ORDER BY order_date
        ) AS previous_order_date
    FROM orders
    WHERE order_status = 'Delivered'
),
purchase_intervals AS (
    SELECT
        user_id,
        DATEDIFF(order_date, previous_order_date) AS days_between_orders
    FROM customer_purchase_dates
    WHERE previous_order_date IS NOT NULL
)
SELECT
    COUNT(*) AS repeat_purchase_intervals,
    COUNT(DISTINCT user_id) AS repeat_customers,
    ROUND(AVG(days_between_orders), 2) AS average_days_between_orders,
    MIN(days_between_orders) AS minimum_days,
    MAX(days_between_orders) AS maximum_days,
    ROUND(STDDEV(days_between_orders), 2) AS standard_deviation_days
FROM purchase_intervals;

-- Which products are frequently purchased together? ---

SELECT
    DATE_FORMAT(order_date, '%Y-%m') AS month,
    COUNT(DISTINCT user_id) AS monthly_purchasing_customers,
    COUNT(*) AS delivered_orders,
    ROUND(SUM(net_amount_inr), 2) AS monthly_revenue
FROM orders
WHERE order_status = 'Delivered'
GROUP BY DATE_FORMAT(order_date, '%Y-%m')
ORDER BY month;


-- Calculate monthly repeat-purchase customers --

WITH customer_monthly_orders AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        user_id,
        COUNT(*) AS total_orders
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY
        DATE_FORMAT(order_date, '%Y-%m'),
        user_id
)
SELECT
    month,
    COUNT(*) AS monthly_customers,
    SUM(CASE WHEN total_orders > 1 THEN 1 ELSE 0 END)
        AS repeat_purchasing_customers,
    ROUND(
        SUM(CASE WHEN total_orders > 1 THEN 1 ELSE 0 END)
        * 100.0 / COUNT(*),
        2
    ) AS monthly_repeat_customer_pct
FROM customer_monthly_orders
GROUP BY month
ORDER BY month;


-- Calculate customer retention using monthly cohorts --

WITH first_purchase AS (
    SELECT
        user_id,
        DATE_FORMAT(MIN(order_date), '%Y-%m') AS cohort_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
monthly_activity AS (
    SELECT DISTINCT
        user_id,
        DATE_FORMAT(order_date, '%Y-%m') AS activity_month
    FROM orders
    WHERE order_status = 'Delivered'
),
cohort_activity AS (
    SELECT
        f.cohort_month,
        a.activity_month,
        COUNT(DISTINCT a.user_id) AS active_customers,
        PERIOD_DIFF(
            REPLACE(a.activity_month, '-', ''),
            REPLACE(f.cohort_month, '-', '')
        ) AS month_number
    FROM first_purchase f
    JOIN monthly_activity a
        ON f.user_id = a.user_id
    WHERE a.activity_month >= f.cohort_month
    GROUP BY
        f.cohort_month,
        a.activity_month
),
cohort_size AS (
    SELECT
        cohort_month,
        COUNT(*) AS cohort_customers
    FROM first_purchase
    GROUP BY cohort_month
)
SELECT
    a.cohort_month,
    a.month_number,
    s.cohort_customers,
    a.active_customers,
    ROUND(
        a.active_customers * 100.0 / s.cohort_customers,
        2
    ) AS retention_pct
FROM cohort_activity a
JOIN cohort_size s
    ON a.cohort_month = s.cohort_month
ORDER BY a.cohort_month, a.month_number;

-- How many customers return after their first purchase?--

WITH first_purchase AS (
    SELECT
        user_id,
        DATE_FORMAT(MIN(order_date), '%Y-%m-01') AS cohort_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY user_id
),
monthly_activity AS (
    SELECT DISTINCT
        user_id,
        DATE_FORMAT(order_date, '%Y-%m-01') AS activity_month
    FROM orders
    WHERE order_status = 'Delivered'
),
cohort_activity AS (
    SELECT
        f.cohort_month,
        a.activity_month,
        TIMESTAMPDIFF(
            MONTH,
            f.cohort_month,
            a.activity_month
        ) AS month_number,
        COUNT(DISTINCT f.user_id) AS active_customers
    FROM first_purchase f
    JOIN monthly_activity a
        ON f.user_id = a.user_id
    GROUP BY
        f.cohort_month,
        a.activity_month
),
cohort_size AS (
    SELECT
        cohort_month,
        COUNT(*) AS cohort_customers
    FROM first_purchase
    GROUP BY cohort_month
)
SELECT
    a.cohort_month,
    s.cohort_customers,
    MAX(CASE WHEN a.month_number = 0 THEN
        ROUND(a.active_customers * 100.0 / s.cohort_customers, 2)
    END) AS month_0,
    MAX(CASE WHEN a.month_number = 1 THEN
        ROUND(a.active_customers * 100.0 / s.cohort_customers, 2)
    END) AS month_1,
    MAX(CASE WHEN a.month_number = 2 THEN
        ROUND(a.active_customers * 100.0 / s.cohort_customers, 2)
    END) AS month_2,
    MAX(CASE WHEN a.month_number = 3 THEN
        ROUND(a.active_customers * 100.0 / s.cohort_customers, 2)
    END) AS month_3
FROM cohort_activity a
JOIN cohort_size s
    ON a.cohort_month = s.cohort_month
GROUP BY
    a.cohort_month,
    s.cohort_customers
ORDER BY a.cohort_month;


-- Which cities have the highest average order value? --

SELECT
    city,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        SUM(net_amount_inr) * 100.0 /
        SUM(SUM(net_amount_inr)) OVER (),
        2
    ) AS revenue_contribution_pct
FROM orders
WHERE order_status = 'Delivered'
  AND city IS NOT NULL
GROUP BY city
ORDER BY average_order_value DESC;

-- Which category performs best in each city? --

WITH city_category_revenue AS (
    SELECT
        city,
        category,
        COUNT(*) AS total_orders,
        SUM(net_amount_inr) AS total_revenue
    FROM orders
    WHERE order_status = 'Delivered'
      AND city IS NOT NULL
    GROUP BY city, category
),
category_ranking AS (
    SELECT
        city,
        category,
        total_orders,
        total_revenue,
        RANK() OVER (
            PARTITION BY city
            ORDER BY total_revenue DESC
        ) AS category_rank
    FROM city_category_revenue
)
SELECT
    city,
    category,
    total_orders,
    ROUND(total_revenue, 2) AS total_revenue,
    category_rank
FROM category_ranking
WHERE category_rank = 1
ORDER BY total_revenue DESC;

-- Calculate discount impact on revenue --

SELECT
    CASE
        WHEN discount_pct_clean = 0 THEN 'No Discount'
        WHEN discount_pct_clean <= 10 THEN '1-10% Discount'
        WHEN discount_pct_clean <= 20 THEN '11-20% Discount'
        ELSE 'Above 20% Discount'
    END AS discount_category,
    COUNT(*) AS total_orders,
    ROUND(AVG(discount_pct_clean), 2) AS average_discount_pct,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue
FROM orders
WHERE order_status = 'Delivered'
GROUP BY discount_category
ORDER BY average_discount_pct;

-- Compare revenue and orders by device --

SELECT
    device,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    ROUND(SUM(net_amount_inr), 2) AS total_revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        COUNT(*) * 100.0 /
        SUM(COUNT(*)) OVER (),
        2
    ) AS order_share_pct
FROM orders
WHERE order_status = 'Delivered'
GROUP BY device
ORDER BY total_revenue DESC;

-- Which products have the highest return rates? --

SELECT
    product_name,
    COUNT(*) AS total_orders,
    SUM(CASE WHEN order_status = 'Returned' THEN 1 ELSE 0 END)
        AS returned_orders,
    ROUND(
        SUM(CASE WHEN order_status = 'Returned' THEN 1 ELSE 0 END)
        * 100.0 / COUNT(*),
        2
    ) AS return_rate_pct,
    ROUND(SUM(net_amount_inr), 2) AS total_order_value
FROM orders
GROUP BY product_name
ORDER BY return_rate_pct DESC;

-- Which categories have the highest return rates? --

SELECT
    category,
    COUNT(*) AS total_orders,
    SUM(
        CASE
            WHEN order_status = 'Returned' THEN 1
            ELSE 0
        END
    ) AS returned_orders,
    ROUND(
        SUM(
            CASE
                WHEN order_status = 'Returned' THEN 1
                ELSE 0
            END
        ) * 100.0 / COUNT(*),
        2
    ) AS return_rate_pct
FROM orders
GROUP BY category
ORDER BY return_rate_pct DESC;

-- Calculate revenue by payment method and order status --

SELECT
    payment_method,
    order_status,
    COUNT(*) AS total_orders,
    ROUND(SUM(net_amount_inr), 2) AS total_order_value,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value
FROM orders
GROUP BY
    payment_method,
    order_status
ORDER BY payment_method, total_orders DESC;


-- Calculate cancellation and return rates by payment method --

SELECT
    payment_method,
    COUNT(*) AS total_orders,

    SUM(
        CASE WHEN order_status = 'Cancelled'
        THEN 1 ELSE 0 END
    ) AS cancelled_orders,

    ROUND(
        SUM(CASE WHEN order_status = 'Cancelled'
        THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
        2
    ) AS cancellation_rate_pct,

    SUM(
        CASE WHEN order_status = 'Returned'
        THEN 1 ELSE 0 END
    ) AS returned_orders,

    ROUND(
        SUM(CASE WHEN order_status = 'Returned'
        THEN 1 ELSE 0 END) * 100.0 / COUNT(*),
        2
    ) AS return_rate_pct

FROM orders
GROUP BY payment_method
ORDER BY cancellation_rate_pct DESC;


SELECT
    COUNT(*) AS total_orders,

    SUM(CASE
        WHEN order_status = 'Delivered' THEN 1
        ELSE 0
    END) AS delivered_orders,

    COUNT(DISTINCT CASE
        WHEN order_status = 'Delivered' THEN user_id
    END) AS delivered_customers,

    SUM(CASE
        WHEN order_status = 'Delivered' THEN quantity
        ELSE 0
    END) AS delivered_units,

    ROUND(SUM(CASE
        WHEN order_status = 'Delivered' THEN net_amount_inr
        ELSE 0
    END), 2) AS delivered_revenue,

    ROUND(
        SUM(CASE
            WHEN order_status = 'Delivered' THEN net_amount_inr
            ELSE 0
        END)
        /
        NULLIF(SUM(CASE
            WHEN order_status = 'Delivered' THEN 1
            ELSE 0
        END), 0),
        2
    ) AS average_order_value

FROM orders;

SELECT
    category,
    COUNT(*) AS total_orders,
    COUNT(DISTINCT user_id) AS unique_customers,
    SUM(quantity) AS units_sold,
    ROUND(SUM(net_amount_inr), 2) AS revenue,
    ROUND(AVG(net_amount_inr), 2) AS average_order_value,
    ROUND(
        SUM(net_amount_inr) * 100.0 /
        SUM(SUM(net_amount_inr)) OVER (),
        2
    ) AS revenue_contribution_pct
FROM orders
WHERE order_status = 'Delivered'
GROUP BY category
ORDER BY revenue DESC;
